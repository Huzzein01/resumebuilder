PORT=4000
MONGODB_URI=mongodb://localhost:27017/resumebuilder
FRONTEND_URL=http://localhost:5173

# --- LLM providers (all optional) ---
# Every AI-augmented feature tries each configured provider in this order,
# falling back to the next on any failure (network error, rate limit, or a
# malformed response) -- and to the deterministic rule-based path where one
# exists if every provider fails or none are configured. Set any subset.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Self-hosted/open-weight backup (last in the failover order) -- any server
# speaking the OpenAI chat-completions API shape works: Ollama (the default
# below), LM Studio, vLLM, llama.cpp's server. No API key; LOCAL_LLM_MODEL is
# the only required var, and it's required precisely so this stays opt-in --
# a dev machine that happens to have Ollama running for something unrelated
# won't silently start receiving this app's prompts.
# LOCAL_LLM_MODEL=llama3.1
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
