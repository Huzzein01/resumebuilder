PORT=4000
MONGODB_URI=mongodb://localhost:27017/resumebuilder
FRONTEND_URL=http://localhost:5173

# --- AI provider (every AI-augmented feature routes through exactly this
# one, chosen entirely by AI_PROVIDER -- no code changes to switch) ---
# See the "AI provider" section in README.md for the full setup walkthrough.
AI_PROVIDER=ollama

# ollama -- local, free, the default. Ollama's OpenAI-compatible endpoint;
# any server speaking the same shape works too (LM Studio, vLLM, llama.cpp's
# server), just point OLLAMA_BASE_URL at it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# anthropic -- set AI_PROVIDER=anthropic and fill in a key to go live. No key
# = the app fails fast with a clear error naming what's missing; it never
# silently falls back to ollama.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# openai / gemini -- also selectable via AI_PROVIDER, adapters already exist.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
