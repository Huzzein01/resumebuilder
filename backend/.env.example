PORT=4000
MONGODB_URI=mongodb://localhost:27017/resumebuilder
FRONTEND_URL=http://localhost:5173

# --- LLM providers (all optional) ---
# Resume import (POST /api/profile/import) tries each configured provider in
# order below, falling back to the deterministic rule-based parser if none
# are configured or all of them fail. Set any subset -- you don't need all three.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
